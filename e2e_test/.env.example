# ImageRoute local configuration
# Custom model artifacts are bundled in the project root:
# model.pth, model_fusion.pth, model_tfidf.pkl, label_map.json

JWT_SECRET=change-this-to-a-long-random-secret
PYTHON_BIN=python

# Leave MySQL empty to use the built-in SQLite fallback.
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=imageroute_ai

# Optional Google/Gmail integration (not used for local model classification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Set true only if you want the visual demo seed records.
DEMO_DATA=false
